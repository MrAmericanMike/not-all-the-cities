{
	"name": "not-all-the-cities",
	"version": "0.1.0",
	"description": "Not All The Cities",
	"author": "MrAmericanMike",
	"type": "module",
	"main": "./dist/main.cjs",
	"types": "./dist/main.d.ts",
	"exports": {
		".": {
			"types": "./dist/main.d.ts",
			"require": "./dist/main.cjs",
			"import": "./dist/main.js",
			"default": "./dist/main.js"
		}
	},
	"scripts": {
		"build": "tsup src/main.ts --format esm,cjs --dts",
		"test": "vitest",
		"coverage": "vitest run --coverage",
		"prepublishOnly": "pnpm run build"
	},
	"files": [
		"dist/**/*",
		"package.json",
		"README.md"
	],
	"repository": {
		"type": "git",
		"url": "git+https://github.com/MrAmericanMike/not-all-the-cities.git"
	},
	"keywords": [
		"NotAllTheCities",
		"not-all-the-cities",
		"cities",
		"coordinates",
		"names",
		"countries",
		"regions",
		"states",
		"populatin",
		"continents",
		"latitude",
		"longitude",
		"geography",
		"all"
	],
	"license": "MIT",
	"homepage": "https://github.com/MrAmericanMike/not-all-the-cities/blob/master/README.md",
	"bugs": {
		"url": "https://github.com/MrAmericanMike/not-all-the-cities/issues"
	},
	"devDependencies": {
		"@types/node": "22.14.0",
		"@vitest/coverage-v8": "3.1.1",
		"tslib": "2.8.1",
		"tsup": "8.5.1",
		"typescript": "5.8.3",
		"vitest": "3.1.1"
	}
}
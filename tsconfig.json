{
	"include": [
		"src/**/*",
		"rollup.config.mjs",
	],
	"compilerOptions": {
		"target": "ES2020",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"skipLibCheck": true,
		"declaration": true,
		"sourceMap": false,
		"noUnusedLocals": true,
		"esModuleInterop": true,
		"types": [
			"node"
		]
	},
	"exclude": [
		"dist",
		"tests/**/*.test.ts"
	]
}